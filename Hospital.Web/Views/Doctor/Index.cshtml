@model IEnumerable<Hospital.Web.ViewModels.DoctorViewModel>

@{
    ViewData["Title"] = "Our Doctors";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Available Doctors</h2>
        <a asp-controller="Specialty" asp-action="Index" class="btn btn-outline-secondary">Back to Specialties</a>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center">
                <div class="alert alert-warning">No doctors found for this specialty right now.</div>
            </div>
        }
        else
        {
            @foreach (var doctor in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <img src="https://cdn-icons-png.flaticon.com/512/3774/3774299.png" alt="Doctor" class="rounded-circle mb-3" style="width: 100px; height: 100px; object-fit: cover;">
                            
                            <h4 class="card-title text-dark">@doctor.FullName</h4>
                            <span class="badge bg-primary mb-2">@doctor.Specialization</span>
                        </div>
                        <div class="card-footer bg-white border-0 text-center pb-3">
                            <a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@doctor.Id" class="btn btn-success w-100">Book Appointment</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>